{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarketWeft",
  "version": "0.92.0",
  "identifier": "org.marketweft.terminal",
  "build": {
    "frontendDist": "../terminal/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarketWeft",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
